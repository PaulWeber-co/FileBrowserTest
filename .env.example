# Vorlage fuer Zugangsdaten. Kopieren nach ".env" - diese Datei wird von
# docker compose automatisch gelesen und gehoert NICHT ins Repository.
#
#   cp .env.example .env
#
# In der SpeedNAS-Oberflaeche traegst du beim Speicherort als Passwort
# dann woertlich ${NAS_PASSWORT} ein statt des echten Passworts.

NAS_PASSWORT=hier-das-echte-passwort

# Zeitzone des Containers
TZ=Europe/Berlin

# Kennung, unter der der Dienst laeuft. Auf dem Wirt herausfinden mit:
#   id -u   und   id -g
PUID=1000
PGID=1000
